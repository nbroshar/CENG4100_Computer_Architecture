 // ---------------------------------------------------------------------------
 // CPU -- ties everything together. Memory lives outside (imem/dmem ports).
 // ---------------------------------------------------------------------------
+// ---------------------------------------------------------------------
+//   clz32  -- count-leading-zeros functional unit (written from scratch)
+// ---------------------------------------------------------------------
+module clz32 (
+    input  wire [31:0] x,
+    output reg  [5:0]  cnt        // number of leading zeros, 0..32
+);
+    integer i;
+    reg found;
+    always @(*) begin
+        cnt   = 6'd32;            // x == 0  ->  32 leading zeros
+        found = 1'b0;
+        for (i = 31; i >= 0; i = i - 1)
+            if (!found && x[i]) begin
+                cnt   = 6'd31 - i[5:0];
+                found = 1'b1;
+            end
+    end
+endmodule
